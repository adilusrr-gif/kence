FROM python:3.11-slim-bookworm

WORKDIR /app

# Установка системных зависимостей для Docling
# Отключаем CDN-кеш apt чтобы получать актуальные пакеты без hash-mismatch
RUN printf 'Acquire::http::No-Cache "true";\nAcquire::http::Pipeline-Depth "0";\nAcquire::Retries "5";\n' \
      > /etc/apt/apt.conf.d/99no-cache
RUN apt-get update && apt-get install -y --no-install-recommends \
    libgl1 \
    libglib2.0-0 \
    libsm6 \
    libxext6 \
    libxrender-dev \
    libgomp1 \
    tesseract-ocr \
    tesseract-ocr-eng \
    fonts-dejavu-core \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt .
RUN pip install --no-cache-dir --timeout=300 --retries=10 \
    --trusted-host pypi.org \
    --trusted-host pypi.python.org \
    --trusted-host files.pythonhosted.org \
    -r requirements.txt

# NOTE: .env is intentionally NOT copied into the image — secrets (JWT key, DB
# passwords) must come from the runtime environment (docker-compose), never be
# baked into image layers.
#
# app/_schema_manifest.json MUST already exist in the build context before
# this COPY runs — it is generated by a pre-build step, not by this
# Dockerfile, because it needs to hash files from ops/schema_audit/ which
# lives outside this image's build context (backend/). Pre-build step, run
# from the repo root:
#   python ops/schema_audit/generate_manifest.py --output backend/app/_schema_manifest.json
# See docs/ALEMBIC_SCHEMA_RECONCILIATION_STAGE_E2_REV3_2026-08-05.md §5 and
# §8 (deployment order) for why this must be a pre-build artifact rather than
# a value computed and trusted at runtime from the same files it verifies.
COPY app/ ./app/

# Alembic config + the ACTIVE migration chain only (versions_archive/ is
# historical record, never executed, intentionally excluded — see
# .dockerignore and backend/alembic/versions_archive/README.md).
COPY alembic.ini .
COPY alembic/ ./alembic/

# Pre-flight manifest check used by the one-shot `migrate` service
# (docker-compose.yml) — verifies migration content before `alembic
# upgrade head` runs.
COPY verify_manifest.py .

EXPOSE 8000

CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000", "--timeout-keep-alive", "1800"]
