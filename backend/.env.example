# ── Application ────────────────────────────────────────────────────────────────
APP_NAME=KENCE.ai

# ── LLM / Ollama ───────────────────────────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
LLM_MODEL=qwen2.5:7b
EMBEDDING_MODEL=bge-m3
VISION_MODEL=llava:7b
CHUNK_SIZE=2000
CHUNK_OVERLAP=400

# LLM concurrency (tune to match GPU capacity)
LLM_MAX_CONCURRENT=2
LLM_QUEUE_MAXSIZE=50
LLM_TIMEOUT_SEC=60

# ── Authentication ─────────────────────────────────────────────────────────────
# REQUIRED in production — generate with: openssl rand -hex 32
JWT_SECRET_KEY=CHANGE_ME_IN_PRODUCTION
# JWT key rotation: set new key above, move old key here. Clear after token TTL expires.
# JWT_SECRET_KEY_PREVIOUS=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Optional: set to control the first admin password; leave empty for auto-generated
# ADMIN_INITIAL_PASSWORD=

# ── Observability ──────────────────────────────────────────────────────────────
# Bearer token required to scrape /metrics. Generate with: openssl rand -hex 32
# If empty, /metrics is restricted to 127.0.0.1 only.
# METRICS_TOKEN=

# ── API Keys ───────────────────────────────────────────────────────────────────
# HMAC secret for API key hashing. Generate with: openssl rand -hex 32
# After setting this, existing API keys must be regenerated.
# API_KEY_HMAC_SECRET=

# ── PostgreSQL ─────────────────────────────────────────────────────────────────
# REQUIRED — must match POSTGRES_PASSWORD below
DATABASE_URL=postgresql://kence:CHANGE_ME@localhost:5432/kenceai
# Used by the postgres container
POSTGRES_PASSWORD=CHANGE_ME

# ── Neo4j ──────────────────────────────────────────────────────────────────────
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
# REQUIRED — used by both the neo4j container and the backend
NEO4J_PASSWORD=CHANGE_ME

# ── Storage ────────────────────────────────────────────────────────────────────
UPLOAD_DIR=./uploads
CHROMA_DIR=./chroma_db

# Ollama model cache — set to the directory that holds your pulled models.
# On Linux/macOS: ~/.ollama   On Windows: C:/Users/<you>/.ollama
OLLAMA_MODELS_PATH=~/.ollama

# ── CORS ───────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins.  Restrict in production.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ── Organisation defaults ──────────────────────────────────────────────────────
DEFAULT_ORG_SLUG=default
API_KEY_PREFIX=kce_

# ── Session ────────────────────────────────────────────────────────────────────
SESSION_TIMEOUT=3600
